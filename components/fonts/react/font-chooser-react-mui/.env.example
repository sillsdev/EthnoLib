# Copy to `.env` (gitignored) before building the demo for deployment.
#
# Without these the demo still runs; it just collects nothing, and the feedback
# dialog says so rather than pretending to send.
#
# Both values are from the Supabase project's Settings > API. The anon /
# publishable key is public by design — it ends up in the deployed bundle, where
# anyone can read it. What it can actually do is fixed by the row-level security
# policies in src/demos/tools/supabase-tables.sql: insert into the two demo
# tables, nothing more. Never put the service_role key here; it bypasses RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
